# Application
NODE_ENV=development
PORT=3000

# PostgreSQL (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=finance
DB_PASSWORD=finance
DB_NAME=finance_tracker

# Auth — generate a real secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1d

# Browser origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:4200

# Redis (for later — BullMQ async imports)
REDIS_HOST=localhost
REDIS_PORT=6379
