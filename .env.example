# Application
NODE_ENV=development
PORT=3000

# PostgreSQL (matches docker-compose.yml defaults).
# In production set DATABASE_URL instead (e.g. Neon) — it wins over DB_* when present.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=finance
DB_PASSWORD=finance
DB_NAME=finance_tracker
# Production / hosted Postgres toggles (leave unset locally):
# DB_SSL=true                 # TLS, required by Neon
# DB_MIGRATIONS_RUN=true      # run pending migrations on boot
# SEED_SYSTEM_CATEGORIES=true # seed shared system categories on boot
# FX_SYNC_ON_BOOT=true        # sync today's FX rates on boot

# Auth — generate a real secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1d

# Browser origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:4200

# Redis (for later — BullMQ async imports)
REDIS_HOST=localhost
REDIS_PORT=6379
